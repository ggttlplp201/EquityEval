# Local development values only. Copy this file to .env; never commit credentials.
POSTGRES_USER=equity
POSTGRES_PASSWORD=equity_local_dev
POSTGRES_DB=equity
POSTGRES_PORT=5433
REDIS_PORT=6380
DATABASE_URL=postgresql+psycopg://equity:equity_local_dev@127.0.0.1:5433/equity
REDIS_URL=redis://127.0.0.1:6380/0
RAW_BLOB_DIR=./var/raw
# Set a real contact before S1/S3 SEC requests. No credentials are needed for S0.
SEC_USER_AGENT=
TIINGO_API_KEY=
FRED_API_KEY=
